    <!-- ═════════ END PEOPLE ═════════ -->

    <!-- ══════════════════════════════════════════════════════════════════
         CARRETILLA ELEVADORA — patrullaje pasillo este libre Y:[-13..13]
         Geometría SDF pura: cuerpo amarillo + horquillas + cabina + ruedas
         Se mueve por animación de pose via script gz::sim::systems::Pose
         (el plugin JointPositionController no aplica; usamos TrajectoryFollower
          o bien el nodo ROS random_walk_people con el mismo SetEntityPose)
         ══════════════════════════════════════════════════════════════════ -->
    <model name="forklift">
      <!-- Posición inicial: pasillo este, extremo sur. Evita recinto del tubo. -->
      <pose>16.0 -13.0 0.0 0 0 1.5708</pose>
      <static>false</static>

      <!-- ── Cuerpo principal (1.2 × 2.4 × 1.4 m) — amarillo industrial ── -->
      <link name="body">
        <inertial>
          <mass>3500.0</mass>
          <inertia>
            <ixx>800.0</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1200.0</iyy><iyz>0</iyz>
            <izz>600.0</izz>
          </inertia>
          <pose>0 0 0.7 0 0 0</pose>
        </inertial>

        <!-- Chasis -->
        <visual name="chassis_vis">
          <pose>0 0 0.7 0 0 0</pose>
          <geometry><box><size>1.2 2.4 1.4</size></box></geometry>
          <material>
            <ambient>0.95 0.80 0.02 1</ambient>
            <diffuse>0.95 0.80 0.02 1</diffuse>
            <specular>0.4 0.35 0.01 1</specular>
          </material>
        </visual>
        <collision name="chassis_col">
          <pose>0 0 0.7 0 0 0</pose>
          <geometry><box><size>1.2 2.4 1.4</size></box></geometry>
        </collision>

        <!-- Cabina del operario (caja oscura encima) -->
        <visual name="cabin_vis">
          <pose>0 -0.3 1.65 0 0 0</pose>
          <geometry><box><size>1.0 1.4 0.8</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="cabin_col">
          <pose>0 -0.3 1.65 0 0 0</pose>
          <geometry><box><size>1.0 1.4 0.8</size></box></geometry>
        </collision>

        <!-- Mástil vertical (estructura elevadora) — barra frontal -->
        <visual name="mast_vis">
          <pose>0 1.3 1.4 0 0 0</pose>
          <geometry><box><size>0.12 0.12 2.8</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
        <collision name="mast_col">
          <pose>0 1.3 1.4 0 0 0</pose>
          <geometry><box><size>0.12 0.12 2.8</size></box></geometry>
        </collision>

        <!-- Horquilla izquierda -->
        <visual name="fork_left_vis">
          <pose>-0.35 1.55 0.15 0 0 0</pose>
          <geometry><box><size>0.12 1.5 0.08</size></box></geometry>
          <material>
            <ambient>0.75 0.65 0.02 1</ambient>
            <diffuse>0.75 0.65 0.02 1</diffuse>
          </material>
        </visual>
        <collision name="fork_left_col">
          <pose>-0.35 1.55 0.15 0 0 0</pose>
          <geometry><box><size>0.12 1.5 0.08</size></box></geometry>
        </collision>

        <!-- Horquilla derecha -->
        <visual name="fork_right_vis">
          <pose>0.35 1.55 0.15 0 0 0</pose>
          <geometry><box><size>0.12 1.5 0.08</size></box></geometry>
          <material>
            <ambient>0.75 0.65 0.02 1</ambient>
            <diffuse>0.75 0.65 0.02 1</diffuse>
          </material>
        </visual>
        <collision name="fork_right_col">
          <pose>0.35 1.55 0.15 0 0 0</pose>
          <geometry><box><size>0.12 1.5 0.08</size></box></geometry>
        </collision>

        <!-- Rueda delantera izquierda -->
        <visual name="wheel_fl_vis">
          <pose>-0.55 1.0 0.25 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.25</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
        <collision name="wheel_fl_col">
          <pose>-0.55 1.0 0.25 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.25</radius><length>0.2</length></cylinder></geometry>
        </collision>

        <!-- Rueda delantera derecha -->
        <visual name="wheel_fr_vis">
          <pose>0.55 1.0 0.25 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.25</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
        <collision name="wheel_fr_col">
          <pose>0.55 1.0 0.25 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.25</radius><length>0.2</length></cylinder></geometry>
        </collision>

        <!-- Rueda trasera izquierda -->
        <visual name="wheel_rl_vis">
          <pose>-0.55 -1.0 0.25 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.25</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
        <collision name="wheel_rl_col">
          <pose>-0.55 -1.0 0.25 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.25</radius><length>0.2</length></cylinder></geometry>
        </collision>

        <!-- Rueda trasera derecha -->
        <visual name="wheel_rr_vis">
          <pose>0.55 -1.0 0.25 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.25</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
        <collision name="wheel_rr_col">
          <pose>0.55 -1.0 0.25 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.25</radius><length>0.2</length></cylinder></geometry>
        </collision>

        <!-- Luz delantera (naranja parpadeo simulado) -->
        <visual name="beacon_vis">
          <pose>0 1.25 2.1 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.15</length></cylinder></geometry>
          <material>
            <ambient>1.0 0.55 0.0 1</ambient>
            <diffuse>1.0 0.55 0.0 1</diffuse>
            <emissive>0.8 0.4 0.0 1</emissive>
          </material>
        </visual>
      </link>

      <!-- Plugin de trayectoria: patrullaje ida/vuelta por pasillo este libre.
           La carretilla apunta al Norte (yaw=π/2) y recorre x=16, Y:-13 ↔ Y:+13
           a 0.5 m/s sin cruzar tubo, rodillos, rampas ni barreras centrales. -->
      <plugin name="gz::sim::systems::TrajectoryFollower" filename="libgz-sim-trajectory-follower-system.so">
        <link_name>body</link_name>
        <loop>true</loop>
        <waypoint>
          <time>0</time>
          <pose>16.0 -13.0 0.0 0 0 1.5708</pose>
        </waypoint>
        <waypoint>
          <time>52</time>
          <pose>16.0 13.0 0.0 0 0 1.5708</pose>
        </waypoint>
        <waypoint>
          <time>104</time>
          <pose>16.0 -13.0 0.0 0 0 1.5708</pose>
        </waypoint>
      </plugin>
    </model>

    <!-- ══════════════════════════════════════════════════════════════════
         ESTANTERÍAS METÁLICAS  — pasillos laterales
         6 racks: 3 lado oeste (x≈-12), 3 lado este (x≈+12)
         Dimensiones: 2.0 (X) × 0.5 (Y) × 2.0 (Z) m — color gris metálico
         Estructura: 4 patas + 3 bandejas horizontales
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Macro-helper: los racks son idénticos salvo pose, definidos inline -->

    <!-- RACK OESTE 1  (x=-12, y=-10) -->
    <model name="rack_w1">
      <pose>-12.0 -10.0 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <!-- Bandeja inferior z=0.6 -->
        <visual name="shelf1_vis"><pose>0 0 0.6 0 0 0</pose><geometry><box><size>2.0 0.5 0.05</size></box></geometry><material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.55 0.57 0.60 1</diffuse></material></visual>
        <collision name="shelf1_col"><pose>0 0 0.6 0 0 0</pose><geometry><box><size>2.0 0.5 0.05</size></box></geometry></collision>
        <!-- Bandeja media z=1.2 -->
        <visual name="shelf2_vis"><pose>0 0 1.2 0 0 0</pose><geometry><box><size>2.0 0.5 0.05</size></box></geometry><material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.55 0.57 0.60 1</diffuse></material></visual>
        <collision name="shelf2_col"><pose>0 0 1.2 0 0 0</pose><geometry><box><size>2.0 0.5 0.05</size></box></geometry></collision>
        <!-- Bandeja superior z=1.95 -->
        <visual name="shelf3_vis"><pose>0 0 1.95 0 0 0</pose><geometry><box><size>2.0 0.5 0.05</size></box></geometry><material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.55 0.57 0.60 1</diffuse></material></visual>
        <collision name="shelf3_col"><pose>0 0 1.95 0 0 0</pose><geometry><box><size>2.0 0.5 0.05</size></box></geometry></collision>
        <!-- Patas: 4 postes 0.05×0.05×2.0 -->
        <visual name="leg_fl"><pose>-0.95 -0.22 1.0 0 0 0</pose><geometry><box><size>0.05 0.05 2.0</size></box></geometry><material><ambient>0.40 0.42 0.45 1</ambient><diffuse>0.40 0.42 0.45 1</diffuse></material></visual>
        <collision name="leg_fl_col"><pose>-0.95 -0.22 1.0 0 0 0</pose><geometry><box><size>0.05 0.05 2.0</size></box></geometry></collision>
        <visual name="leg_fr"><pose>0.95 -0.22 1.0 0 0 0</pose><geometry><box><size>0.05 0.05 2.0</size></box></geometry><material><ambient>0.40 0.42 0.45 1</ambient><diffuse>0.40 0.42 0.45 1</diffuse></material></visual>
        <collision name="leg_fr_col"><pose>0.95 -0.22 1.0 0 0 0</pose><geometry><box><size>0.05 0.05 2.0</size></box></geometry></collision>
        <visual name="leg_bl"><pose>-0.95 0.22 1.0 0 0 0</pose><geometry><box><size>0.05 0.05 2.0</size></box></geometry><material><ambient>0.40 0.42 0.45 1</ambient><diffuse>0.40 0.42 0.45 1</diffuse></material></visual>
        <collision name="leg_bl_col"><pose>-0.95 0.22 1.0 0 0 0</pose><geometry><box><size>0.05 0.05 2.0</size></box></geometry></collision>
        <visual name="leg_br"><pose>0.95 0.22 1.0 0 0 0</pose><geometry><box><size>0.05 0.05 2.0</size></box></geometry><material><ambient>0.40 0.42 0.45 1</ambient><diffuse>0.40 0.42 0.45 1</diffuse></material></visual>
        <collision name="leg_br_col"><pose>0.95 0.22 1.0 0 0 0</pose><geometry><box><size>0.05 0.05 2.0</size></box></geometry></collision>
      </link>
    </model>

    <!-- RACK OESTE 2  (x=-12, y=-4) -->
    <model name="rack_w2">
      <pose>-12.0 -4.0 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
