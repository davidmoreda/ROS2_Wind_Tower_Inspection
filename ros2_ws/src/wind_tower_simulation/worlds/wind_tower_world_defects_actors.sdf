<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="wind_tower_world">

    <!-- Gravedad reducida (de -9.8 a -7.5) para compensar par limitado del Husky -->
    <!-- subiendo la rampa de 13°. Reduce ~23% el peso aparente; la tracción sigue -->
    <!-- siendo suficiente con mu=3.0 + slip=0 en las superficies de la rampa. -->
    <gravity>0 0 -7.5</gravity>

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.2</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <plugin name='gz::sim::systems::Physics'        filename='libgz-sim-physics-system.so'/>
    <plugin name='gz::sim::systems::UserCommands'   filename='libgz-sim-user-commands-system.so'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='libgz-sim-scene-broadcaster-system.so'/>
    <plugin name='gz::sim::systems::Contact'        filename='libgz-sim-contact-system.so'/>
    <plugin name="gz::sim::systems::Sensors"        filename="libgz-sim-sensors-system.so">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Imu"    filename="libgz-sim-imu-system.so"/>
    <plugin name="gz::sim::systems::NavSat" filename="libgz-sim-navsat-system.so"/>

    <scene>
      <ambient>0.50 0.50 0.52 1</ambient>
      <background>0.18 0.18 0.22 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 25 0 0 0</pose>
      <diffuse>0.85 0.83 0.78 1</diffuse>
      <specular>0.25 0.24 0.22 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- Fluorescentes estación de carga -->
    <light type="point" name="light_charge_A">
      <pose>0 25 6 0 0 0</pose>
      <diffuse>0.95 0.95 1.0 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>15</range><constant>0.4</constant><linear>0.06</linear><quadratic>0.008</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Fluorescentes sala control -->
    <light type="point" name="light_control_A">
      <pose>0 -25 6 0 0 0</pose>
      <diffuse>0.95 0.95 1.0 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>15</range><constant>0.4</constant><linear>0.06</linear><quadratic>0.008</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ══════════════════════════════════════════════
         SUELO — hormigón industrial pulido
         ══════════════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <contact><ode>
              <kp>500000</kp><kd>100</kd>
              <max_vel>0.5</max_vel><min_depth>0.002</min_depth>
            </ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.38 0.37 0.35 1</ambient>
            <diffuse>0.48 0.46 0.43 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════
         NAVE  30 × 60 × 18 m  (X:-15/+15  Y:-30/+30)
         Paredes exteriores — hormigón prefabricado
         ══════════════════════════════════════════════ -->
    <model name="wall_north">
      <static>true</static><pose>0 30 9 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>40 0.4 18</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>40 0.4 18</size></box></geometry>
          <material><ambient>0.72 0.70 0.66 1</ambient><diffuse>0.78 0.76 0.72 1</diffuse><specular>0.03 0.03 0.03 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>0 -30 9 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>40 0.4 18</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>40 0.4 18</size></box></geometry>
          <material><ambient>0.72 0.70 0.66 1</ambient><diffuse>0.78 0.76 0.72 1</diffuse><specular>0.03 0.03 0.03 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>20 0 9 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 60 18</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.4 60 18</size></box></geometry>
          <material><ambient>0.68 0.66 0.62 1</ambient><diffuse>0.74 0.72 0.68 1</diffuse><specular>0.03 0.03 0.03 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static><pose>-20 0 9 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 60 18</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.4 60 18</size></box></geometry>
          <material><ambient>0.68 0.66 0.62 1</ambient><diffuse>0.74 0.72 0.68 1</diffuse><specular>0.03 0.03 0.03 1</specular></material>
        </visual>
      </link>
    </model>

