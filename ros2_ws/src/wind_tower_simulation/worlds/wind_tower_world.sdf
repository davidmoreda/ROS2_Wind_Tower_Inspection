    <!-- ══════════════════════════════════════════════
         TRAMO DE TORRE EÓLICA — elevado 1 m
         Centro sección (mundo): x=0, z=5
         ══════════════════════════════════════════════ -->
    <model name="wind_tower_tube">
      <static>false</static>
      <pose>-4 15 1 1.5708 0 0</pose>
      <link name="tube_link">
        <inertial>
          <mass>2000</mass>
          <inertia>
            <ixx>155000</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>155000</iyy><iyz>0</iyz>
            <izz>32000</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <mesh><uri>model://TRAMO_TORRE.STL</uri><scale>0.001 0.001 0.001</scale></mesh>
          </geometry>
          <material>
            <ambient>0.48 0.52 0.56 1</ambient>
            <diffuse>0.55 0.59 0.64 1</diffuse>
            <specular>0.35 0.35 0.35 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <mesh><uri>model://TRAMO_TORRE.STL</uri><scale>0.001 0.001 0.001</scale></mesh>
          </geometry>
        </collision>
      </link>

      <joint name="turner_joint" type="revolute">
        <parent>world</parent>
        <child>tube_link</child>
        <pose>4.0 4.0 0 0 0 0</pose>
        <axis>
          <xyz expressed_in="__model__">0 0 1</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
          <dynamics><damping>2.0</damping><friction>0.1</friction></dynamics>
        </axis>
      </joint>

      <plugin filename="gz-sim-joint-controller-system"
              name="gz::sim::systems::JointController">
        <joint_name>turner_joint</joint_name>
        <use_force_commands>false</use_force_commands>
        <initial_velocity>0.0</initial_velocity>
      </plugin>
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher"/>
    </model>

    <!-- ══════════════════════════════════════════════
         VIRADORES — 2 conjuntos × 2 rodillos
         Tubo elevado 1 m → centro sección (x=0, z=5)

         Rodillos en V-cradle a ±45°:
           x = ±(4+0.4)·sin45° = ±3.11 m
           z = 5−(4+0.4)·cos45° = 1.89 m

         ORIENTACIÓN: eje del rodillo paralelo al tubo (eje Y)
         En SDF cilindro tiene eje Z por defecto.
         Para orientar eje → Y: roll=1.5708 (90° alrededor X)
         Pose: x  y  z  1.5708 0 0
         ══════════════════════════════════════════════ -->

    <!-- Bastidor norte (Y=+10) — acero RAL 7022 -->
    <model name="roller_frame_north">
      <static>true</static><pose>0 10 0.4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8.0 1.5 0.8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8.0 1.5 0.8</size></box></geometry>
          <material><ambient>0.28 0.29 0.30 1</ambient><diffuse>0.33 0.34 0.36 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Rodillo norte derecho — eje paralelo al tubo (Y) -->
    <model name="roller_N_right">
      <static>true</static>
      <pose>3.11 10 1.89 1.5708 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.4</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.4</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.65 0.68 0.72 1</diffuse><specular>0.70 0.70 0.70 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Rodillo norte izquierdo — eje paralelo al tubo (Y) -->
    <model name="roller_N_left">
      <static>true</static>
      <pose>-3.11 10 1.89 1.5708 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.4</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.4</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.65 0.68 0.72 1</diffuse><specular>0.70 0.70 0.70 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════
         RAMPA NORTE — acceso al tubo por extremo Y=+15
         Y=+20 (z=0, suelo, ras)  →  Y=+15 (z=1.14, sobre borde tubo)
         roll=-0.230 rad (≈13°), 5 m longitud, empotrada en suelo
         Transición 0°→6.5°→13° mediante cuña de entrada (0.4 m)
         Color: amarillo seguridad RAL 1003
         ══════════════════════════════════════════════ -->

    <!-- Cuña de entrada norte: suaviza discontinuidad 0°→13° en dos pasos -->
    <!-- Cubre Y=19.6 a 20.0 con inclinación media (6.5°, roll=-0.115 rad)  -->
    <!-- z_c=-0.056: cierra gap <1mm con cuerpo principal en Y=19.6 -->
    <!-- Fricción mu=3.0 (antes 1.5) + slip nulo para reducir el patinaje -->
    <!-- al pasar por la transición de pendiente. -->
    <model name="ramp_north_entry">
      <static>true</static>
      <pose>0 19.8 -0.056 -0.115 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>4.0 0.4 0.15</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>3.0</mu>
                <mu2>3.0</mu2>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
            <contact><ode>
              <kp>1000000</kp><kd>50</kd>
              <max_vel>0.1</max_vel><min_depth>0.001</min_depth>
            </ode></contact>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>4.0 0.4 0.15</size></box></geometry>
          <material>
            <ambient>0.90 0.78 0.04 1</ambient><diffuse>1.0 0.88 0.05 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cuerpo principal de la rampa norte (Y=15 a Y=19.6) -->
    <!-- Termina EXACTAMENTE en Y=15 (borde tubo), sin meterse dentro     -->
    <!-- z_c=0.497 → entrada Y=19.6 a z=0.046m, tubo Y=15 a z=1.094m    -->
    <!-- Fricción mu=3.0 (antes 1.5) + slip1/slip2 = 0 + max_vel=0.1: -->
    <!-- triplica el coeficiente de fricción Coulomb y reduce el slip ODE -->
    <!-- para que las ruedas del Husky agarren con par limitado en 13°. -->
    <!-- min_depth bajado (0.002→0.001) → contacto menos hundido → patch -->
    <!-- de contacto más realista y mayor presión normal efectiva. -->
    <model name="ramp_north">
      <static>true</static>
      <pose>0 17.3 0.497 -0.230 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>4.0 4.6 0.15</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>3.0</mu>
                <mu2>3.0</mu2>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
            <contact><ode>
              <kp>1000000</kp><kd>50</kd>
              <max_vel>0.1</max_vel><min_depth>0.001</min_depth>
            </ode></contact>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>4.0 4.6 0.15</size></box></geometry>
          <material>
            <ambient>0.90 0.78 0.04 1</ambient>
            <diffuse>1.0  0.88 0.05 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════
         RAMPA INTERIOR — transición suave al suelo del tubo
         Y=+15.1 (z=1.094, al ras con ramp_north sur)
            →   Y=+7   (z=1.000, suelo del tubo en x=0)
         Longitud 8.1 m, pendiente 0.665° (roll=+0.01161 rad)
         Reemplaza ramp_junction + ramp_small_south anteriores:
         elimina escalón de 20 mm en Y=15.08 que bloqueaba al Husky.
         La unión con ramp_north queda a z=1.094 sin discontinuidad.
         Ancho 4 m, grosor 0.15 m, mu=1.5 (max agarre).
         ══════════════════════════════════════════════ -->

    <model name="ramp_inner">
      <static>true</static>
      <pose>0 11.05 0.972 0.01161 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>4.0 8.1 0.15</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>3.0</mu>
                <mu2>3.0</mu2>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
            <contact><ode>
              <kp>1000000</kp><kd>50</kd>
              <max_vel>0.1</max_vel><min_depth>0.001</min_depth>
            </ode></contact>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>4.0 8.1 0.15</size></box></geometry>
          <material>
            <ambient>0.90 0.78 0.04 1</ambient>
            <diffuse>1.0  0.88 0.05 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════
         BARRERAS METÁLICAS — perímetro zona tubo
         Perimetro: X=±5, Y=-16 a Y=+16
         Apertura norte para rampa: X=-1.25 a X=+1.25
         Barandillas laterales de rampa: X=±1.25, Y=+15 a +19
         Color: naranja seguridad industrial
         ══════════════════════════════════════════════ -->

    <!-- Barrera sur (cierra extremo Y=-16) -->
    <model name="barrier_south">
      <static>true</static><pose>0 -16 0.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.3 0.15 1.2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10.3 0.15 1.2</size></box></geometry>
          <material><ambient>0.85 0.35 0.03 1</ambient><diffuse>0.95 0.42 0.04 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Barrera este (X=+5, Y=-16 a Y=+16) -->
    <model name="barrier_east">
      <static>true</static><pose>5 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 32.0 1.2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.15 32.0 1.2</size></box></geometry>
          <material><ambient>0.85 0.35 0.03 1</ambient><diffuse>0.95 0.42 0.04 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Barrera oeste (X=-5, Y=-16 a Y=+16) -->
    <model name="barrier_west">
      <static>true</static><pose>-5 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 32.0 1.2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.15 32.0 1.2</size></box></geometry>
          <material><ambient>0.85 0.35 0.03 1</ambient><diffuse>0.95 0.42 0.04 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Barrera norte izquierda (Y=+16, X=-5 a -2.0) — apertura 4 m -->
    <model name="barrier_north_L">
      <static>true</static><pose>-3.5 16 0.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.0 0.15 1.2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.0 0.15 1.2</size></box></geometry>
          <material><ambient>0.85 0.35 0.03 1</ambient><diffuse>0.95 0.42 0.04 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Barrera norte derecha (Y=+16, X=+2.0 a +5) — apertura 4 m -->
    <model name="barrier_north_R">
      <static>true</static><pose>3.5 16 0.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.0 0.15 1.2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.0 0.15 1.2</size></box></geometry>
          <material><ambient>0.85 0.35 0.03 1</ambient><diffuse>0.95 0.42 0.04 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Barandilla rampa norte lado oeste — acortada a Y=15–18.5 (3.5m) -->
    <!-- Deja libre Y=18.5–20 a los lados para que el robot pueda rodear la rampa -->
    <model name="barrier_ramp_W">
      <static>true</static><pose>-2.0 16.75 0.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 3.5 1.2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.15 3.5 1.2</size></box></geometry>
          <material><ambient>0.85 0.35 0.03 1</ambient><diffuse>0.95 0.42 0.04 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Barandilla rampa norte lado este — acortada a Y=15–18.5 (3.5m) -->
    <model name="barrier_ramp_E">
      <static>true</static><pose>2.0 16.75 0.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 3.5 1.2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.15 3.5 1.2</size></box></geometry>
          <material><ambient>0.85 0.35 0.03 1</ambient><diffuse>0.95 0.42 0.04 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Bastidor sur (Y=-10) -->
    <model name="roller_frame_south">
      <static>true</static><pose>0 -10 0.4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8.0 1.5 0.8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8.0 1.5 0.8</size></box></geometry>
          <material><ambient>0.28 0.29 0.30 1</ambient><diffuse>0.33 0.34 0.36 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Rodillo sur derecho — eje paralelo al tubo (Y) -->
    <model name="roller_S_right">
      <static>true</static>
      <pose>3.11 -10 1.89 1.5708 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.4</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.4</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.65 0.68 0.72 1</diffuse><specular>0.70 0.70 0.70 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Rodillo sur izquierdo — eje paralelo al tubo (Y) -->
    <model name="roller_S_left">
      <static>true</static>
      <pose>-3.11 -10 1.89 1.5708 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.4</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.4</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.65 0.68 0.72 1</diffuse><specular>0.70 0.70 0.70 1</specular></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
