<?xml version="1.0"?>
<model>
  <name>actor_walking</name>
  <version>1.0</version>
  <author>
    <name>Wind Tower Inspection</name>
  </author>
  <description>
    Skinned + animated walking human (walk.dae from Gazebo Fuel "Mingfei/actor").
    Used as the &lt;skin&gt; and walk &lt;animation&gt; source for the &lt;actor&gt;
    elements in the wind tower world. Visual only — LiDAR detection is provided
    by separate invisible collision-capsule models synced to each actor.
  </description>
</model>
